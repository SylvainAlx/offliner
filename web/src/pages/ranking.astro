---
export const prerender = false; // ⚡ Rend la page à la demande (SSR)

import H1 from "../components/h1.astro";
import Layout from "../layouts/Layout.astro";
import { PROJECT } from "shared/config";
import { getPowerSavingEstimate } from "shared/utils/powerSaving";
import {
  getTotalDuration,
  getUsersRanking,
  getWeeklyLeagueRanking,
} from "src/api/users";
import { getTopTeamsRanking } from "src/api/teams";
import { formatDuration } from "shared/utils/formatDuration";
import RankingTable from "../components/RankingTable.tsx";
import UserSearch from "../components/UserSearch.tsx";
import TeamRankingTable from "../components/TeamRankingTable.tsx";
import H2 from "src/components/h2.astro";

// 📡 Récupération des données côté serveur
const data = await getUsersRanking();
const weeklyData = await getWeeklyLeagueRanking();
const teamsData = await getTopTeamsRanking();
const totalDuration = await getTotalDuration();
const powerSavingEstimate = getPowerSavingEstimate(totalDuration);

const dataWithFormatted = (data || []).map((u) => ({
  ...u,
  // on prépare aussi des valeurs numériques sûres pour le tri
  total_duration_num: u.total_duration || 0,
  // et on calcule l'affichage de la durée côté serveur (formatDuration est disponible)
  formatted_total_duration: formatDuration(u.total_duration || 0),
}));

const weeklyDataWithFormatted = (weeklyData || []).map((u) => ({
  ...u,
  // on prépare aussi des valeurs numériques sûres pour le tri
  total_duration_num: u.total_duration || 0,
  // et on calcule l'affichage de la durée côté serveur (formatDuration est disponible)
  formatted_total_duration: formatDuration(u.total_duration || 0),
}));

const teamsDataWithFormatted = (teamsData || []).map((t) => ({
  ...t,
  formatted_total_duration: formatDuration(t.total_duration || 0),
}));
---

<Layout
  title={`${PROJECT.TITLE} | Classement`}
  description={PROJECT.DESCRIPTION}
>
  <H1 title="Classement des utilisateurs et des équipes" />
  <section
    id="users"
    class="flex flex-col items-center w-full max-w-5xl px-4 gap-4 text-xl"
  >
    <H2 title="Classement des utilisateurs" />
    <p>
      Les utilisateur de {PROJECT.TITLE} ont, en totalité, passé <span
        class="text-accent">{formatDuration(totalDuration, true)}</span
      > hors ligne et économisé environ <span class="text-accent"
        >{powerSavingEstimate}</span
      >.
    </p>
    <!-- UI (recherche) au-dessus du tableau -->
    <div class="w-full mt-6 flex flex-col items-center gap-6">
      <UserSearch client:load />
    </div>

    <!-- Composant React pour le tableau et les onglets -->
    <RankingTable
      client:load
      initialGlobalData={dataWithFormatted}
      initialWeeklyData={weeklyDataWithFormatted}
    />
  </section>
  <section
    id="teams"
    class="flex flex-col items-center w-full max-w-5xl px-4 gap-4 text-xl mt-12"
  >
    <H2 title="Classement des équipes" />
    <TeamRankingTable client:load data={teamsDataWithFormatted} />
  </section>
</Layout>
