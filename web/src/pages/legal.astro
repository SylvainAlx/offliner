---
import Layout from "../layouts/Layout.astro";
import H1 from "src/components/h1.astro";
import H2 from "src/components/h2.astro";
import { PROJECT, OWNER } from "shared/config";
import "../styles/global.css";
const lastUpdate = "24-11-2025";
---

<Layout
  title={`Mentions légales - ${PROJECT.TITLE}`}
  description="Mentions légales et informations juridiques du site Offliner"
>
  <section class="flex flex-col items-center w-full px-4 pb-12">
    <div class="max-w-4xl w-full">
      <H1 title="Mentions légales" />

      <div class="prose prose-lg max-w-none mt-8">
        <p class="text-base-content/70 text-sm">
          <strong>Dernière mise à jour :</strong>
          {lastUpdate}
        </p>

        <div class="divider"></div>

        <section class="mb-8">
          <H2 title="À propos du projet" />
          <p class="text-base-content/80">{PROJECT.DESCRIPTION}</p>
          <p class="text-base-content/80">
            <strong>Slogan :</strong> {PROJECT.SLOGAN}
          </p>
        </section>

        <!-- 1. Éditeur du site -->
        <section class="mb-8">
          <H2 title="1. Éditeur du site" />
          <div class="text-base-content/80 space-y-2">
            <p><strong>Nom :</strong> {OWNER.NAME}</p>
            <p>
              <strong>Email :</strong>
              <a href={`mailto:${OWNER.CONTACT}`} class="link link-secondary"
                >{OWNER.CONTACT}</a
              >
            </p>
            <p>
              <strong>Site web :</strong>
              <a
                href={OWNER.WEBSITE}
                target="_blank"
                class="link link-secondary">{OWNER.WEBSITE}</a
              >
            </p>
          </div>
        </section>

        <!-- 2. Hébergement -->
        <section class="mb-8">
          <H2 title="2. Hébergement" />
          <div class="text-base-content/80 space-y-2">
            <p><strong>Hébergeur :</strong> Vercel Inc.</p>
            <p>
              <strong>Adresse :</strong> 340 S Lemon Ave #4133, Walnut, CA 91789,
              USA
            </p>
            <p>
              <strong>Site web :</strong>
              <a
                href="https://vercel.com"
                target="_blank"
                class="link link-secondary">vercel.com</a
              >
            </p>
          </div>
        </section>

        <!-- 3. Propriété intellectuelle -->
        <section class="mb-8">
          <H2 title="3. Propriété intellectuelle" />
          <p class="text-base-content/80">
            L'ensemble du contenu de ce site (textes, images, graphismes, logo,
            icônes, sons, logiciels) est la propriété exclusive de l'Éditeur, à
            l'exception des marques, logos ou contenus appartenant à d'autres
            sociétés partenaires ou auteurs.
          </p>
          <p class="text-base-content/80">
            Toute reproduction, distribution, modification, adaptation,
            retransmission ou publication de ces différents éléments est
            strictement interdite sans l'accord exprès par écrit de l'Éditeur.
          </p>
        </section>

        <!-- 4. Données personnelles -->
        <section class="mb-8">
          <H2 title="4. Protection des données personnelles" />
          <p class="text-base-content/80">
            Conformément au Règlement Général sur la Protection des Données
            (RGPD) et à la loi Informatique et Libertés, vous disposez d'un
            droit d'accès, de rectification, de suppression et d'opposition aux
            données personnelles vous concernant.
          </p>
          <p class="text-base-content/80">
            Pour plus d'informations, consultez notre <a
              href="/privacy"
              class="link link-secondary">Politique de confidentialité</a
            >.
          </p>
          <p class="text-base-content/80">
            <strong>Contact DPO :</strong>
            <a href={`mailto:${OWNER.CONTACT}`} class="link link-secondary"
              >{OWNER.CONTACT}</a
            >
          </p>
        </section>

        <!-- 5. Cookies et traceurs -->
        <section class="mb-8">
          <H2 title="5. Cookies et analytics" />
          <p class="text-base-content/80">
            Ce site utilise <strong>Matomo</strong>, un outil d'analyse web
            respectueux de la vie privée, avec anonymisation des adresses IP.
            Les données collectées sont uniquement utilisées pour améliorer
            l'expérience utilisateur.
          </p>
          <p class="text-base-content/80">
            Aucun cookie publicitaire ou de tracking tiers n'est utilisé.
          </p>
        </section>

        <!-- 6. Responsabilité -->
        <section class="mb-8">
          <H2 title="6. Limitation de responsabilité" />
          <p class="text-base-content/80">
            l'Éditeur s'efforce d'assurer l'exactitude et la mise à jour des
            informations diffusées sur ce site. Toutefois, l'Éditeur ne peut
            garantir l'exactitude, la précision ou l'exhaustivité des
            informations mises à disposition sur ce site.
          </p>
          <p class="text-base-content/80">
            l'Éditeur ne pourra être tenu responsable des dommages directs et
            indirects causés au matériel de l'utilisateur lors de l'accès au
            site, et résultant soit de l'utilisation d'un matériel ne répondant
            pas aux spécifications techniques requises, soit de l'apparition
            d'un bug ou d'une incompatibilité.
          </p>
        </section>

        <!-- 7. Liens hypertextes -->
        <section class="mb-8">
          <H2 title="7. Liens hypertextes" />
          <p class="text-base-content/80">
            Ce site peut contenir des liens hypertextes vers d'autres sites.
            l'Éditeur n'exerce aucun contrôle sur ces sites et décline toute
            responsabilité quant à leur contenu.
          </p>
        </section>

        <!-- 8. Droit applicable -->
        <section class="mb-8">
          <H2 title="8. Droit applicable et juridiction" />
          <p class="text-base-content/80">
            Les présentes mentions légales sont régies par le droit français. En
            cas de litige et à défaut d'accord amiable, le litige sera porté
            devant les tribunaux français conformément aux règles de compétence
            en vigueur.
          </p>
        </section>

        <!-- 9. Crédits -->
        <section class="mb-8">
          <H2 title="9. Crédits" />
          <div class="text-base-content/80 space-y-2">
            <p><strong>Conception et développement :</strong> {OWNER.NAME}</p>
            <p><strong>Framework :</strong> Astro</p>
            <p><strong>Hébergement :</strong> Vercel</p>
            <p><strong>Analytics :</strong> Matomo</p>
          </div>
        </section>

        <div class="divider"></div>

        <p class="text-center text-sm text-base-content/50">
          <strong>Version :</strong>
          {PROJECT.VERSION} | <strong>Dernière révision :</strong>
          {lastUpdate}
        </p>
      </div>
    </div>
  </section>
</Layout>
