---
import Layout from "../layouts/Layout.astro";
import { PROJECT } from "shared/config";
---

<Layout
  title={`Réinitialisation du mot de passe - ${PROJECT.TITLE}`}
  description="Réinitialisez votre mot de passe"
>
  <div class="container mx-auto px-4 py-12 max-w-md">
    <div class="card bg-base-200 shadow-xl">
      <div class="card-body">
        <h1 class="card-title text-2xl font-bold mb-4">
          Nouveau mot de passe
        </h1>

        <div id="loading-state" class="text-center py-8">
          <span class="loading loading-spinner loading-lg"></span>
          <p class="mt-4 text-base-content/70">
            Vérification de votre session...
          </p>
        </div>

        <div id="error-state" class="hidden">
          <div class="alert alert-error mb-4">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="stroke-current shrink-0 h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"
              ></path>
            </svg>
            <span id="error-message"></span>
          </div>
          <a href="/" class="btn btn-primary w-full">Retour à l'accueil</a>
        </div>

        <form id="reset-form" class="hidden space-y-4">
          <div class="form-control">
            <label class="label" for="password">
              <span class="label-text">Nouveau mot de passe</span>
            </label>
            <input
              type="password"
              id="password"
              name="password"
              placeholder="Minimum 6 caractères"
              class="input input-bordered w-full"
              required
              minlength="6"
            />
          </div>

          <div class="form-control">
            <label class="label" for="confirm-password">
              <span class="label-text">Confirmer le mot de passe</span>
            </label>
            <input
              type="password"
              id="confirm-password"
              name="confirm-password"
              placeholder="Confirme ton mot de passe"
              class="input input-bordered w-full"
              required
              minlength="6"
            />
          </div>

          <div id="form-error" class="alert alert-warning hidden">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="stroke-current shrink-0 h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
              ></path>
            </svg>
            <span id="form-error-message"></span>
          </div>

          <div id="success-state" class="alert alert-success hidden">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="stroke-current shrink-0 h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span>Mot de passe mis à jour avec succès ! Redirection...</span>
          </div>

          <button type="submit" class="btn btn-primary w-full" id="submit-btn">
            Valider
          </button>
        </form>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { verifyPasswordResetToken, updatePassword } from "../api/auth";

  const loadingState = document.getElementById("loading-state")!;
  const errorState = document.getElementById("error-state")!;
  const errorMessage = document.getElementById("error-message")!;
  const resetForm = document.getElementById("reset-form") as HTMLFormElement;
  const formError = document.getElementById("form-error")!;
  const formErrorMessage = document.getElementById("form-error-message")!;
  const successState = document.getElementById("success-state")!;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
  const passwordInput = document.getElementById("password") as HTMLInputElement;
  const confirmPasswordInput = document.getElementById(
    "confirm-password",
  ) as HTMLInputElement;

  // Verify token on page load
  async function init() {
    const result = await verifyPasswordResetToken();

    if (!result.isValid) {
      loadingState.classList.add("hidden");
      errorState.classList.remove("hidden");
      errorMessage.textContent =
        result.error || "Session invalide ou expirée.";
      return;
    }

    // Show the form
    loadingState.classList.add("hidden");
    resetForm.classList.remove("hidden");
  }

  // Handle form submission
  resetForm.addEventListener("submit", async (e) => {
    e.preventDefault();

    const password = passwordInput.value;
    const confirmPassword = confirmPasswordInput.value;

    // Reset previous errors
    formError.classList.add("hidden");
    successState.classList.add("hidden");

    // Validate passwords match
    if (password !== confirmPassword) {
      formError.classList.remove("hidden");
      formErrorMessage.textContent = "Les mots de passe ne correspondent pas.";
      return;
    }

    // Validate password length
    if (password.length < 6) {
      formError.classList.remove("hidden");
      formErrorMessage.textContent =
        "Le mot de passe doit contenir au moins 6 caractères.";
      return;
    }

    // Disable form during submission
    submitBtn.disabled = true;
    submitBtn.classList.add("loading");

    // Update password
    const result = await updatePassword(password);

    submitBtn.disabled = false;
    submitBtn.classList.remove("loading");

    if (!result.success) {
      formError.classList.remove("hidden");
      formErrorMessage.textContent =
        result.error || "Une erreur est survenue.";
      return;
    }

    // Show success and redirect
    successState.classList.remove("hidden");
    resetForm.querySelectorAll("input, button").forEach((el) => {
      (el as HTMLInputElement | HTMLButtonElement).disabled = true;
    });

    setTimeout(() => {
      window.location.href = "/";
    }, 2000);
  });

  // Initialize on page load
  init();
</script>
