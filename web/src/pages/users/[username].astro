---
export const prerender = false; // 🚀 SSR activé

import { formatDuration } from "shared/utils/formatDuration";
import Layout from "../../layouts/Layout.astro";
import H1 from "../../components/h1.astro";
import { PROJECT } from "shared/config";
import { getRanking, getUser } from "src/api/users";
import DataCard from "../../components/dataCard.astro";
import { getLatestDeviceNameByUserId } from "src/api/devices";
import Devider from "../../components/devider.astro";
import { Trophy, Home } from "@lucide/astro";
import { getPowerSavingEstimate } from "shared/utils/powerSaving";
import GradientButton from "../../components/GradientButton.astro";

const { username } = Astro.params;

const user = await getUser(username);

let rankingWorld = null;
let rankingCountry = null;
let rankingRegion = null;
let rankingDepartment = null;
let devices = null;

if (user) {
  devices = await getLatestDeviceNameByUserId(user.id);
  rankingWorld = await getRanking(null, username);
  if (user.country) rankingCountry = await getRanking(
    { column: "country", value: user.country },
    username,
  );
  if (user.region) rankingRegion = await getRanking(
    { column: "region", value: user.region },
    username,
  );
  if (user.subregion) rankingDepartment = await getRanking(
    {
      column: "subregion",
      value: user.subregion,
    },
    username,
  );
  
}
---

<Layout
  title={`${PROJECT.TITLE} | Profil ${username}`}
  description={PROJECT.DESCRIPTION}
>
  <section class="flex flex-col items-center w-full max-w-7xl px-4">
    <H1 title={`Profil de ${username}`} />
    {
      user ? (
          <Devider label="Classement" />
          <div class="p-4 rounded-lg flex justify-center flex-wrap gap-4 w-full">
            {rankingWorld ? (
            <DataCard
              title="Monde"
              data={rankingWorld.rank}
              dataSup={rankingWorld.rank > 1 ? "ème" : "er"}
              info={`sur ${rankingWorld.total} utilisateur(s)`}
            />
          ) : (
            <p>"N/A"</p>
          )}
          {rankingCountry ? (
            <DataCard
              title={user.country}
              data={rankingCountry.rank}
              dataSup={rankingCountry.rank > 1 ? "ème" : "er"}
              info={`sur ${rankingCountry.total} utilisateur(s)`}
            />
          ) : (
            <DataCard
              title="Pays"
              data="Aucune information"
            />
          )}
          {rankingRegion ? (
            <DataCard
              title={user.region}
              data={rankingRegion.rank}
              dataSup={rankingRegion.rank > 1 ? "ème" : "er"}
              info={`sur ${rankingRegion.total} utilisateur(s)`}
            />
          ) : (
            <DataCard
              title="Région"
              data="Aucune information"
            />
          )}
          {rankingDepartment ? (
            <DataCard
              title={user.subregion || "-"}
              data={rankingDepartment.rank}
              dataSup={rankingDepartment.rank > 1 ? "ème" : "er"}
              info={`sur ${rankingDepartment.total} utilisateur(s)`}
            />
          ) : (
            <DataCard
              title="Département"
              data="Aucune information"
            />
          )}
          </div>
          <Devider label="Informations" />
        <div class="p-4 rounded-lg flex justify-center flex-wrap gap-4 w-full">
          <DataCard
            title="Temps passé hors-ligne"
            data={formatDuration(user.total_duration)}
          />

          <DataCard
            title="Économie d'énergie estimée"
            data={getPowerSavingEstimate(user.total_duration)}
          />
          {devices ?
          (<DataCard title="Appareil utilisé" data={devices} />)
             : (
               <DataCard
              title="Appareil utilisé"
              data="Aucune information"
            />
            )}
            <DataCard
              title="Date d'inscription"
              data={new Date(user.created_at).toLocaleDateString("fr-FR", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })}
            />
          </div>
      ) : (
        <p>Utilisateur introuvable.</p>
      )
    }
    <div
      class="my-8 flex flex-col sm:flex-row items-center justify-center gap-3"
    >
      <GradientButton
        href="/ranking"
        variant="secondary"
        class="hover:text-secondary/80"
        icon={Trophy}
      >
        Les meilleurs offliners
      </GradientButton>
      <GradientButton
        href="/"
        variant="secondary"
        class="hover:text-secondary/80"
        icon={Home}
      >
        Accueil
      </GradientButton>
    </div>
  </section>
</Layout>
