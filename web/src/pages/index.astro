---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import { PROJECT } from "shared/config";
import GettingStarted from "src/components/gettingStarted.astro";
import Benefits from "src/components/benefits.astro";
import FAQ from "src/components/faq.astro";
import Hero from "src/components/hero.astro";
import Features from "src/components/features.astro";
import CTAFinal from "src/components/ctaFinal.astro";
---

<Layout title={`${PROJECT.TITLE}`} description={PROJECT.DESCRIPTION}>
  <div class="flex flex-col gap-24 w-full">
    <Hero />
    <Benefits />
    <Features />
    <GettingStarted />
    <FAQ />
    <CTAFinal />
  </div>
</Layout>
