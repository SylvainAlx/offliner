---
import Layout from "../layouts/Layout.astro";
import H1 from "src/components/h1.astro";
import H2 from "src/components/h2.astro";
import { PROJECT, OWNER } from "shared/config";
import "../styles/global.css";
const lastUpdate = "24-11-2025";
---

<Layout
  title={`Politique de Confidentialité - ${PROJECT.TITLE}`}
  description="Politique de confidentialité et protection des données personnelles de l'application Offliner"
>
  <section class="flex flex-col items-center w-full px-4 pb-12">
    <div class="max-w-4xl w-full">
      <H1 title="Politique de Confidentialité" />

      <div class="prose prose-lg max-w-none mt-8">
        <p class="text-base-content/70 text-sm">
          <strong>Dernière mise à jour :</strong>
          {lastUpdate}
        </p>

        <div class="divider"></div>

        <!-- Introduction -->
        <section class="mb-8">
          <p class="text-base-content/80">
            Bienvenue sur <strong>{PROJECT.TITLE}</strong>. Cette politique de
            confidentialité explique comment nous collectons, utilisons,
            partageons et protégeons vos informations personnelles lorsque vous
            utilisez notre application mobile.
          </p>
          <p class="text-base-content/80">
            En utilisant {PROJECT.TITLE}, vous acceptez les pratiques décrites
            dans cette politique de confidentialité.
          </p>
        </section>

        <!-- 1. Informations collectées -->
        <section class="mb-8">
          <H2 title="1. Informations que nous collectons" />

          <h3 class="text-xl font-semibold text-accent mt-6 mb-3">
            1.1 Informations que vous nous fournissez
          </h3>
          <ul class="list-disc list-inside space-y-2 text-base-content/80">
            <li>
              <strong>Informations de compte :</strong> Adresse e-mail, nom d'utilisateur,
              mot de passe (stocké de manière sécurisée et cryptée)
            </li>
            <li>
              <strong>Données d'utilisation :</strong> Mesures et statistiques de
              temps hors ligne, objectifs personnels, transactions et activités dans
              l'application
            </li>
          </ul>

          <h3 class="text-xl font-semibold text-accent mt-6 mb-3">
            1.2 Informations collectées automatiquement
          </h3>
          <ul class="list-disc list-inside space-y-2 text-base-content/80">
            <li>Type d'appareil et modèle</li>
            <li>Système d'exploitation et version</li>
            <li>Identifiant unique de l'appareil</li>
            <li>Données de connexion et d'utilisation</li>
          </ul>

          <div class="alert alert-info mt-4">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              class="stroke-current shrink-0 w-6 h-6"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              ></path>
            </svg>
            <span
              >Nous ne collectons <strong>aucune donnée de localisation</strong>
              précise.</span
            >
          </div>
        </section>

        <!-- 2. Utilisation des données -->
        <section class="mb-8">
          <H2 title="2. Comment nous utilisons vos informations" />

          <p class="text-base-content/80 mb-4">
            Nous utilisons vos informations pour :
          </p>

          <div class="grid md:grid-cols-2 gap-4">
            <div class="card bg-base-200 shadow-sm">
              <div class="card-body">
                <h3 class="card-title text-accent text-lg">
                  Fournir nos services
                </h3>
                <ul class="list-disc list-inside space-y-1 text-sm">
                  <li>Créer et gérer votre compte</li>
                  <li>Synchroniser vos données</li>
                  <li>Afficher vos statistiques</li>
                  <li>Personnaliser votre expérience</li>
                </ul>
              </div>
            </div>

            <div class="card bg-base-200 shadow-sm">
              <div class="card-body">
                <h3 class="card-title text-accent text-lg">
                  Sécurité et amélioration
                </h3>
                <ul class="list-disc list-inside space-y-1 text-sm">
                  <li>Protéger votre compte</li>
                  <li>Analyser l'utilisation</li>
                  <li>Corriger les bugs</li>
                  <li>Développer de nouvelles fonctionnalités</li>
                </ul>
              </div>
            </div>
          </div>
        </section>

        <!-- 3. Partage des données -->
        <section class="mb-8">
          <H2 title="3. Partage de vos informations" />

          <div class="alert alert-success mb-4">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="stroke-current shrink-0 h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span
              ><strong>Nous ne vendons JAMAIS vos données personnelles.</strong
              ></span
            >
          </div>

          <h3 class="text-xl font-semibold text-accent mt-6 mb-3">
            Fournisseurs de services
          </h3>
          <div class="overflow-x-auto">
            <table class="table table-zebra">
              <thead>
                <tr>
                  <th>Service</th>
                  <th>Finalité</th>
                  <th>Politique de confidentialité</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>Supabase</strong></td>
                  <td>Base de données et authentification</td>
                  <td>
                    <a
                      href="https://supabase.com/privacy"
                      target="_blank"
                      class="link link-secondary">supabase.com/privacy</a
                    >
                  </td>
                </tr>
                <tr>
                  <td><strong>Expo</strong></td>
                  <td>Plateforme de développement mobile</td>
                  <td>
                    <a
                      href="https://expo.dev/privacy"
                      target="_blank"
                      class="link link-secondary">expo.dev/privacy</a
                    >
                  </td>
                </tr>
                <tr>
                  <td><strong>Matomo</strong></td>
                  <td>Statistiques web anonymes (site web uniquement)</td>
                  <td>
                    <a
                      href="https://matomo.org/privacy-policy/"
                      target="_blank"
                      class="link link-secondary">matomo.org/privacy-policy</a
                    >
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <h3 class="text-xl font-semibold text-accent mt-6 mb-3">
            Données publiques
          </h3>
          <p class="text-base-content/80">
            Votre nom d'utilisateur et vos statistiques peuvent être visibles
            par d'autres utilisateurs dans les <a
              href="/ranking"
              class="link link-secondary">classements publics</a
            >.
          </p>
        </section>

        <!-- 4. Sécurité -->
        <section class="mb-8">
          <H2 title="4. Stockage et sécurité des données" />

          <div class="stats stats-vertical lg:stats-horizontal shadow w-full">
            <div class="stat">
              <div class="stat-figure text-secondary">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  class="inline-block w-8 h-8 stroke-current"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"
                  ></path>
                </svg>
              </div>
              <div class="stat-title">Cryptage</div>
              <div class="stat-value text-secondary text-2xl">HTTPS/TLS</div>
              <div class="stat-desc">Données en transit sécurisées</div>
            </div>

            <div class="stat">
              <div class="stat-figure text-accent">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  class="inline-block w-8 h-8 stroke-current"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
              </div>
              <div class="stat-title">Mots de passe</div>
              <div class="stat-value text-accent text-2xl">Cryptés</div>
              <div class="stat-desc">Stockage sécurisé</div>
            </div>

            <div class="stat">
              <div class="stat-figure text-primary">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  class="inline-block w-8 h-8 stroke-current"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
              </div>
              <div class="stat-title">Hébergement</div>
              <div class="stat-value text-primary text-2xl">Cloud</div>
              <div class="stat-desc">Infrastructure sécurisée</div>
            </div>
          </div>
        </section>

        <!-- 5. Vos droits -->
        <section class="mb-8">
          <H2 title="5. Vos droits (RGPD)" />

          <p class="text-base-content/80 mb-4">
            Conformément au RGPD, vous disposez des droits suivants :
          </p>

          <div class="grid md:grid-cols-2 gap-3">
            <div class="badge badge-outline badge-lg p-4 justify-start">
              ✓ Droit d'accès à vos données
            </div>
            <div class="badge badge-outline badge-lg p-4 justify-start">
              ✓ Droit de rectification
            </div>
            <div class="badge badge-outline badge-lg p-4 justify-start">
              ✓ Droit à l'effacement
            </div>
            <div class="badge badge-outline badge-lg p-4 justify-start">
              ✓ Droit à la portabilité
            </div>
            <div class="badge badge-outline badge-lg p-4 justify-start">
              ✓ Droit d'opposition
            </div>
            <div class="badge badge-outline badge-lg p-4 justify-start">
              ✓ Droit de retrait du consentement
            </div>
          </div>

          <div class="alert mt-6">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              class="stroke-info shrink-0 w-6 h-6"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              ></path>
            </svg>
            <div>
              <h3 class="font-bold">Comment exercer vos droits ?</h3>
              <div class="text-xs">
                Contactez-nous à : <a
                  href={`mailto:${OWNER.CONTACT}`}
                  class="link link-secondary">{OWNER.CONTACT}</a
                >
              </div>
            </div>
          </div>
        </section>

        <!-- 6. Mineurs -->
        <section class="mb-8">
          <H2 title="6. Données des mineurs" />
          <p class="text-base-content/80">
            {PROJECT.TITLE} n'est pas destiné aux enfants de moins de 13 ans (ou
            16 ans dans l'UE). Nous ne collectons pas sciemment d'informations personnelles
            auprès de mineurs.
          </p>
        </section>

        <!-- 7. Cookies -->
        <section class="mb-8">
          <H2 title="7. Cookies et technologies similaires" />

          <h3 class="text-xl font-semibold text-accent mt-6 mb-3">
            Application mobile
          </h3>
          <div class="alert alert-info">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              class="stroke-current shrink-0 w-6 h-6"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              ></path>
            </svg>
            <span
              >Notre application mobile utilise uniquement le <strong
                >stockage local</strong
              > pour vos préférences et données hors ligne. <strong
                >Aucun cookie publicitaire</strong
              > n'est utilisé.</span
            >
          </div>

          <h3 class="text-xl font-semibold text-accent mt-6 mb-3">
            Site web - Matomo Analytics
          </h3>
          <p class="text-base-content/80 mb-4">
            Notre site web utilise <strong>Matomo</strong>, une solution
            d'analyse web respectueuse de la vie privée, pour comprendre comment
            les visiteurs utilisent notre site.
          </p>

          <div class="card bg-base-200 shadow-sm mb-4">
            <div class="card-body">
              <h4 class="font-semibold text-accent mb-2">
                Données collectées par Matomo :
              </h4>
              <ul
                class="list-disc list-inside space-y-1 text-sm text-base-content/80"
              >
                <li>Pages visitées et durée de visite</li>
                <li>Type de navigateur et système d'exploitation</li>
                <li>Résolution d'écran</li>
                <li>Provenance (site référent)</li>
                <li>
                  Adresse IP <strong>anonymisée</strong> (2 derniers octets masqués)
                </li>
              </ul>
            </div>
          </div>

          <div class="alert alert-success">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="stroke-current shrink-0 h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <div>
              <div class="font-bold">Respect de votre vie privée</div>
              <div class="text-sm">
                <ul class="list-disc list-inside mt-2 space-y-1">
                  <li>
                    Données hébergées sur nos propres serveurs (pas de tiers)
                  </li>
                  <li>Adresses IP anonymisées automatiquement</li>
                  <li>Aucun partage de données avec des tiers</li>
                  <li>Pas de publicité ciblée</li>
                  <li>Conformité RGPD totale</li>
                </ul>
              </div>
            </div>
          </div>
        </section>

        <!-- 8. Modifications -->
        <section class="mb-8">
          <H2 title="8. Modifications de cette politique" />
          <p class="text-base-content/80">
            Nous pouvons mettre à jour cette politique de confidentialité de
            temps en temps. Nous vous informerons de tout changement
            significatif par notification dans l'application ou par email.
          </p>
        </section>

        <!-- 9. Contact -->
        <section class="mb-8">
          <H2 title="9. Contact" />

          <div class="card bg-base-200 shadow-md">
            <div class="card-body">
              <h3 class="card-title text-accent">
                Questions sur cette politique ?
              </h3>
              <div class="space-y-2">
                <p>
                  <strong>Email :</strong>
                  <a
                    href={`mailto:${OWNER.CONTACT}`}
                    class="link link-secondary">{OWNER.CONTACT}</a
                  >
                </p>
                <p>
                  <strong>Site web :</strong>
                  <a
                    href={OWNER.WEBSITE}
                    target="_blank"
                    class="link link-secondary">{OWNER.WEBSITE}</a
                  >
                </p>
                <p>
                  <strong>Responsable du traitement :</strong>
                  {OWNER.NAME}
                </p>
              </div>
            </div>
          </div>
        </section>

        <!-- Résumé -->
        <section class="mb-8">
          <H2 title="Résumé en points clés" />

          <div class="grid md:grid-cols-2 gap-3">
            <div class="flex items-start gap-2">
              <span class="text-success text-2xl">✓</span>
              <span class="text-base-content/80"
                >Données nécessaires uniquement</span
              >
            </div>
            <div class="flex items-start gap-2">
              <span class="text-success text-2xl">✓</span>
              <span class="text-base-content/80">Aucune vente de données</span>
            </div>
            <div class="flex items-start gap-2">
              <span class="text-success text-2xl">✓</span>
              <span class="text-base-content/80">Stockage sécurisé</span>
            </div>
            <div class="flex items-start gap-2">
              <span class="text-success text-2xl">✓</span>
              <span class="text-base-content/80"
                >Suppression possible à tout moment</span
              >
            </div>
            <div class="flex items-start gap-2">
              <span class="text-success text-2xl">✓</span>
              <span class="text-base-content/80">Conformité RGPD</span>
            </div>
            <div class="flex items-start gap-2">
              <span class="text-success text-2xl">✓</span>
              <span class="text-base-content/80">Pas de publicité ciblée</span>
            </div>
          </div>
        </section>

        <div class="divider"></div>

        <p class="text-center text-sm text-base-content/50">
          <strong>Version :</strong>
          {PROJECT.VERSION} | <strong>Dernière révision :</strong>
          {lastUpdate}
        </p>
      </div>
    </div>
  </section>
</Layout>
