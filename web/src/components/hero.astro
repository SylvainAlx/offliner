---
import { DONATION, PROJECT } from "shared/config";
import GradientButton from "./GradientButton.astro";
import { Download, Trophy, Heart } from "@lucide/astro";
import { Image } from "astro:assets";
import preview from "../../public/preview.webp";
---

<section
  class="relative w-full h-screen flex flex-col lg:flex-row items-center justify-center px-10 py-12 gap-12 overflow-hidden"
>
  <!-- Background decoration -->
  <div
    class="absolute top-0 left-0 w-full h-full bg-linear-to-br from-primary/5 to-secondary/5 -z-10"
  >
  </div>
  <div
    class="absolute -top-24 -right-24 w-96 h-96 bg-primary/10 rounded-full blur-3xl"
  >
  </div>
  <div
    class="absolute -bottom-24 -left-24 w-96 h-96 bg-secondary/10 rounded-full blur-3xl"
  >
  </div>

  <!-- Text Content -->
  <div
    class="-mt-24 flex-1 max-w-2xl flex flex-col items-center justify-center lg:items-start lg:justify-start gap-6 z-10"
  >
    <div
      class="flex items-center gap-2 px-3 py-1 bg-warning/10 border border-warning/20 text-warning rounded-full text-xs font-medium uppercase tracking-wider mb-2 animate-pulse"
    >
      <span class="relative flex h-2 w-2">
        <span
          class="animate-ping absolute inline-flex h-full w-full rounded-full bg-warning opacity-75"
        ></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-warning"
        ></span>
      </span>
      Version Beta
    </div>
    <h1
      class="text-3xl text-center lg:text-left lg:text-5xl font-bold leading-tight"
    >
      Retrouvez votre <span class="text-primary">liberté</span> numérique avec
      <span class="text-secondary"> Offliner</span>
    </h1>
    <p
      class="text-lg text-center lg:text-left lg:text-xl text-base-content/80 leading-relaxed"
    >
      {PROJECT.DESCRIPTION}. <br />
      Déconnectez pour mieux vous reconnecter à l'essentiel.
    </p>

    <!-- Beta Disclaimer -->
    <div class="flex items-start gap-2 max-w-lg">
      <div class="text-warning mt-1 shrink-0">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-5 h-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path
            d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"
          ></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg
        >
      </div>
      <p class="text-sm text-base-content/60 italic">
        Offliner est actuellement en version <strong>beta</strong>. Des
        instabilités peuvent survenir et le service évolue régulièrement pour
        mieux vous servir.
      </p>
    </div>

    <div class="flex flex-col sm:flex-row gap-4 mt-4">
      <GradientButton
        href={import.meta.env.PUBLIC_DOWNLOADS_URL}
        variant="primary"
        icon={Download}
      >
        Télécharger
      </GradientButton>
      <GradientButton href="/ranking" variant="secondary" icon={Trophy}>
        Classement
      </GradientButton>
      <GradientButton
        href={DONATION.PAYPAL_URL}
        target="_blank"
        rel="noopener noreferrer"
        variant="secondary"
        fullWidth
        icon={Heart}
      >
        Soutenir le projet
      </GradientButton>
    </div>
  </div>

  <!-- Visual Content (Placeholder or Illustration) -->
  <Image
    src={preview}
    loading="eager"
    alt="Preview"
    class="absolute inset-0 w-full h-full object-cover opacity-10 z-0 lg:relative lg:w-auto lg:h-auto lg:opacity-100 lg:z-10 lg:max-w-[30%] lg:flex-1"
  />
</section>
