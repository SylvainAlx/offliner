---
import { PROJECT } from "shared/config";
import Download from "./svg/download.astro";
import RankingIcon from "./svg/rankingIcon.astro";
---

<section
  class="relative w-full h-screen flex flex-col lg:flex-row items-center justify-center px-10 py-12 gap-12 overflow-hidden"
>
  <!-- Background decoration -->
  <div
    class="absolute top-0 left-0 w-full h-full bg-linear-to-br from-primary/5 to-secondary/5 -z-10"
  >
  </div>
  <div
    class="absolute -top-24 -right-24 w-96 h-96 bg-primary/10 rounded-full blur-3xl"
  >
  </div>
  <div
    class="absolute -bottom-24 -left-24 w-96 h-96 bg-secondary/10 rounded-full blur-3xl"
  >
  </div>

  <!-- Text Content -->
  <div
    class="flex-1 max-w-2xl flex flex-col items-center justify-center lg:items-start lg:justify-start gap-6 z-10"
  >
    <h1
      class="text-3xl text-center lg:text-left lg:text-5xl font-bold leading-tight"
    >
      Retrouvez votre <span class="text-primary">liberté</span> numérique avec
      <span class="text-secondary"> Offliner</span>
    </h1>
    <p
      class="text-lg text-center lg:text-left lg:text-xl text-base-content/80 leading-relaxed"
    >
      {PROJECT.DESCRIPTION}. <br />
      Déconnectez pour mieux vous reconnecter à l'essentiel.
    </p>

    <div class="flex flex-col sm:flex-row gap-4 mt-4">
      <a
        href={import.meta.env.PUBLIC_DOWNLOADS_URL}
        class="btn btn-primary btn-lg rounded-full gap-2 shadow-lg hover:scale-105 transition-transform"
      >
        <Download />
        Télécharger l'app
      </a>
      <a
        href="/ranking"
        class="btn btn-outline btn-secondary btn-lg rounded-full gap-2 hover:scale-105 transition-transform"
      >
        <RankingIcon />
        Voir le classement
      </a>
    </div>
  </div>

  <!-- Visual Content (Placeholder or Illustration) -->
  <div
    class="max-w-[30%] lg:max-w-[50%] lg:flex-1 hidden lg:flex justify-center items-center relative z-10"
  >
    <div class="relative w-full max-w-md aspect-square">
      <!-- Abstract representation of disconnection -->
      <div
        class="absolute inset-0 bg-linear-to-tr from-primary to-secondary rounded-full opacity-20 animate-pulse"
      >
      </div>
      <div
        class="absolute inset-4 bg-base-100 rounded-2xl shadow-2xl flex items-center justify-center border border-base-300"
      >
        <div class="text-center p-8">
          <p class="text-2xl font-bold">Mode Hors Ligne</p>
          <p class="text-success font-mono mt-2">Activé</p>
        </div>
      </div>
    </div>
  </div>
</section>
