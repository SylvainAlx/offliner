---
import FeatureCard from "./featureCard.astro";
import H2 from "./h2.astro";
---

<section class="px-4">
  <div class="max-w-6xl mx-auto">
    <H2 title="Fonctionnalités Clés" />
    <div class="flex justify-center flex-wrap gap-6 mt-12">
      <FeatureCard
        badge="Auto"
        title="Suivi Automatique"
        content="Détection intelligente de vos périodes sans connexion. Laissez l'app faire le travail."
      />
      <FeatureCard
        badge="Stats"
        title="Analyses Précises"
        content="Comprenez vos habitudes avec des graphiques détaillés par jour et par semaine."
      />
      <FeatureCard
        badge="Fun"
        title="Gamification"
        content="Gagnez des récompenses et grimpez dans le classement en restant déconnecté."
      />
    </div>
  </div>
</section>
