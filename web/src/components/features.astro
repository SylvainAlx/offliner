---
import FeatureCard from "./featureCard.astro";
import H2 from "./h2.astro";
---

<section class="px-4">
  <div class="max-w-6xl mx-auto">
    <H2 title="Fonctionnalités Clés" />
    <div class="flex justify-center flex-wrap gap-6 mt-12">
      <FeatureCard title="Suivi Automatique">
        Détection intelligente de vos périodes sans connexion. Laissez l'app
        faire le travail.
      </FeatureCard>
      <FeatureCard title="Analyses Précises">
        Comprenez vos habitudes en consultant vos statistiques par jour et par
        semaine.
      </FeatureCard>
      <FeatureCard title="Gamification">
        Gagnez des gemmes et grimpez dans le classement en restant déconnecté,
        seul ou en équipe.
      </FeatureCard>
    </div>
  </div>
</section>
