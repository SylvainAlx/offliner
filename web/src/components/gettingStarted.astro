---
import { PROJECT } from "shared/config";
import { CircleCheck } from "lucide-astro";
import H2 from "./h2.astro";
---

<!-- Getting Started -->
<section class="bg-base-200 py-16 px-4">
  <div class="max-w-4xl mx-auto">
    <H2 title="Comment ça marche ?" />
    <div class="mt-8">
      <ul class="timeline timeline-vertical lg:[&>li>p]:text-lg">
        <li>
          <div class="timeline-start">Étape 1</div>
          <div class="timeline-middle">
            <CircleCheck class="w-6 h-6 text-accent" />
          </div>
          <p class="timeline-end timeline-box">
            Téléchargez et installez {PROJECT.TITLE} avec le lien ci-dessus
          </p>
          <hr class="bg-accent" />
        </li>
        <li>
          <hr class="bg-accent" />
          <div class="timeline-start">Étape 2</div>
          <div class="timeline-middle">
            <CircleCheck class="w-6 h-6 text-accent" />
          </div>
          <p class="timeline-end timeline-box">Créez un compte (facultatif)</p>
          <hr class="bg-accent" />
        </li>
        <li>
          <hr class="bg-accent" />
          <div class="timeline-start">Étape 3</div>
          <div class="timeline-middle">
            <CircleCheck class="w-6 h-6 text-accent" />
          </div>
          <p class="timeline-end timeline-box">
            Coupez le Wifi et les données mobiles !
          </p>
          <hr class="bg-accent" />
        </li>
        <li>
          <hr class="bg-accent" />
          <div class="timeline-start">Étape 5</div>
          <div class="timeline-middle">
            <CircleCheck class="w-6 h-6 text-accent" />
          </div>
          <p class="timeline-end timeline-box">
            Commulez le temps hors ligne pour atteindre les objectifs
          </p>
          <hr class="bg-accent" />
        </li>
        <li>
          <hr class="bg-accent" />
          <div class="timeline-start">Étape 6</div>
          <div class="timeline-middle">
            <CircleCheck class="w-6 h-6 text-accent" />
          </div>
          <p class="timeline-end timeline-box">
            Partagez votre performance avec la communauté
          </p>
          <hr class="bg-accent" />
        </li>
        <li>
          <hr class="bg-accent" />
          <div class="timeline-start">Étape 7</div>
          <div class="timeline-middle">
            <CircleCheck class="w-6 h-6 text-accent" />
          </div>
          <p class="timeline-end timeline-box">
            Minez des gemmes de temps pour montrer votre régularité
          </p>
        </li>
      </ul>
    </div>
  </div>
</section>
