    <a href="/" class="btn btn-ghost text-xl gap-2 h-auto py-2">
      <img src="/logo.png" alt={PROJECT.TITLE} class="w-10 h-10 rounded-full" />
      <span class="hidden sm:inline">{PROJECT.TITLE}</span>
    </a>
  </div>
  <div class="flex-none">
    <ul class="menu menu-horizontal px-1 gap-2">
      <li><a href="/">Accueil</a></li>
      <li><a href="/ranking">Classement</a></li>
      <li><a href="/goals">Objectifs</a></li>
    </ul>
  </div>
</header>
