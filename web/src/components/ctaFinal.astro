---
import GradientButton from "./GradientButton.astro";
import { Download } from "lucide-astro";
---

<section class="py-16 px-4 text-center">
  <h2 class="text-3xl font-bold mb-8">Prêt à déconnecter ?</h2>
  <div class="flex flex-col justify-center items-center gap-4">
    <GradientButton
      href={import.meta.env.PUBLIC_DOWNLOADS_URL}
      variant="primary"
      class="max-w-md"
      icon={Download}
    >
      Commencer maintenant
    </GradientButton>
  </div>
</section>
