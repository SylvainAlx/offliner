---
interface Props {
  variant?: "primary" | "secondary" | "accent" | "danger" | "warning";
  type?: "button" | "submit" | "reset";
  href?: string;
  fullWidth?: boolean;
  disabled?: boolean;
  class?: string;
  id?: string;
  icon?: any;
  [key: string]: any; // Allow arbitrary props
}

const {
  variant = "primary",
  type = "button",
  href,
  fullWidth = false,
  disabled = false,
  class: className = "",
  id,
  icon: Icon,
  ...rest
} = Astro.props;

// Couleurs du projet (shared/theme.ts)
const variantStyles = {
  primary:
    "bg-[#ff89ff] hover:bg-[#ff5fff] text-white shadow-[0_4px_15px_rgba(255,137,255,0.3)] hover:shadow-[0_6px_20px_rgba(255,137,255,0.4)]",
  secondary:
    "bg-[#00abff] hover:bg-[#0088ff] text-white shadow-[0_4px_15px_rgba(0,171,255,0.3)] hover:shadow-[0_6px_20px_rgba(0,171,255,0.4)]",
  accent:
    "bg-[#ffffa8] hover:bg-[#ffff70] text-gray-900 shadow-[0_4px_15px_rgba(255,255,168,0.3)] hover:shadow-[0_6px_20px_rgba(255,255,168,0.4)]",
  danger:
    "bg-[#D72638] hover:bg-[#EF476F] text-white shadow-[0_4px_15px_rgba(215,38,56,0.3)] hover:shadow-[0_6px_20px_rgba(215,38,56,0.4)]",
  warning:
    "bg-[#FFA600] hover:bg-[#FF8800] text-white shadow-[0_4px_15px_rgba(255,166,0,0.3)] hover:shadow-[0_6px_20px_rgba(255,166,0,0.4)]",
};

const baseClasses =
  "cursor-pointer inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full font-semibold text-base transition-all duration-200 ease-in-out min-h-[48px] hover:-translate-y-0.5 active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:translate-y-0";

const classes = `${baseClasses} ${variantStyles[variant]} ${fullWidth ? "w-full" : ""} ${className}`;
---

{
  href ? (
    <a href={href} class={classes} id={id} {...rest}>
      {Icon && <Icon class="w-5 h-5" />}
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} disabled={disabled} id={id} {...rest}>
      {Icon && <Icon class="w-5 h-5" />}
      <slot />
    </button>
  )
}
